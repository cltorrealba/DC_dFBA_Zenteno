    "\n",
    "print(\"\\nBounds aplicados a flujos clave:\")\n",
    "for rid in [\"r_2111\", \"r_1714\", \"r_1709\", \"r_1761\", \"r_1992\", \"r_4046\"] + KINETIC_N_SOURCE_IDS:\n",
