    "            if col == \"N_free_gN_L\" and \"N_gN_L\" in states_df_phase.columns:\n",
    "                states_df_phase[col] = states_df_phase[\"N_gN_L\"]\n",
    "            else:\n",
    "                states_df_phase[col] = default\n",
    "\n",
    "if \"flux_df_phase\" in globals() and flux_df_phase is not None:\n",
