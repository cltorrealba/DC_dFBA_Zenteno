    "    Kf0_nom    = 7.5\n",
    "    Kig0_nom   = 55.0\n",
    "    Kie0_nom   = 40.0\n",
    "    Kd0_nom    = 0.00044\n",
    "    betaG0_nom = 0.225\n",
