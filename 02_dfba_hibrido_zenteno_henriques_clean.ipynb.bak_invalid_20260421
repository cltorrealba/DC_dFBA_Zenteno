    "## 4. Aplicación del medio vínico\n",
    "\n",
    "Configuración anaerobia (O₂ cerrado), glucosa+fructosa abiertas como fuentes C, NH₄⁺ + 8 AAs como fuentes N (resto cerrado), trazas de vitaminas/iones, ATPM fijado al NGAM. La función opera en place sobre `model`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def apply_wine_medium(mdl: cobra.Model) -> dict:\n",
    "    \"\"\"Configura bounds del medio vínico anaerobio sobre `mdl` (in place).\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    dict con conteos de bounds modificados por grupo.\n",
    "    \"\"\"\n",
    "    rb = {r.id: r for r in mdl.reactions}\n",
    "    counts = {}\n",
    "\n",
    "    def _set(rid: str, lb: float, ub: float, group: str):\n",
    "        if rid not in rb:\n",
    "            return\n",
    "        r = rb[rid]\n",
    "        r.lower_bound = float(lb)\n",
    "        r.upper_bound = float(ub)\n",
    "        counts[group] = counts.get(group, 0) + 1\n",
    "\n",
    "    # Anaerobiosis\n",
    "    _set(RXN_IDS[\"O2\"], 0.0, 0.0, \"anaerobiosis\")\n",
    "    # Carbono (glucosa + fructosa abiertas)\n",
    "    _set(RXN_IDS[\"GLU\"], -1000.0, 0.0, \"carbon\")\n",
    "    _set(RXN_IDS[\"FRU\"], -1000.0, 0.0, \"carbon\")\n",
    "    # Productos abiertos\n",
    "    _set(RXN_IDS[\"ETH\"], 0.0, 1000.0, \"products\")\n",
    "    # ATPM fija (NGAM)\n",
    "    _set(RXN_IDS[\"ATPM\"], PARAMS[\"ATPM_LB_NO_GROWTH\"], PARAMS[\"ATPM_LB_NO_GROWTH\"], \"atpm\")\n",
    "\n",
    "    # Cierra fuentes N no cinéticas (mantén abiertas las KINETIC_N_SOURCE_IDS)\n",
    "    n_kin = set(KINETIC_N_SOURCE_IDS)\n",
    "    for r in mdl.reactions:\n",
    "        nm = (r.name or \"\").lower()\n",
    "        if (\"exchange\" in nm) and (\" amino\" in f\" {nm} \" or \"amine\" in nm) and r.id not in n_kin:\n",
    "            _set(r.id, 0.0, 1000.0, \"n_closed_aa\")\n",
    "    for rid in n_kin:\n",
    "        _set(rid, -1000.0, 0.0, \"n_kinetic_open\")\n",
    "\n",
    "    return counts\n",
    "\n",
    "\n",
    "medium_summary = apply_wine_medium(model)\n",
    "print(\"Bounds aplicados por grupo:\")\n",
    "for k, v in medium_summary.items():\n",
    "    print(f\"  {k:20s}: {v}\")\n",
    "\n",
    "# Auto-detección de exchanges de aminoácidos precursores de aromas\n",
    "_AA_KEYWORDS = {\n",
    "    \"phe\": \"phenylalanine\",\n",
    "    \"leu\": \"leucine\",\n",
    "    \"val\": \"valine\",\n",
    "    \"met\": \"methionine\",\n",
    "    \"tyr\": \"tyrosine\",\n",
    "}\n",
    "_AROMA_KEYWORDS = {\n",
    "    \"pea\"          : \"2-phenylethanol\",\n",
    "    \"isoamyl\"      : \"isoamyl alcohol\",\n",
    "    \"isobutanol\"   : \"isobutanol\",\n",
    "    \"methionol\"    : \"methionol\",\n",
    "    \"tyrosol\"      : \"tyrosol\",\n",
    "    \"ethyl_acetate\": \"ethyl acetate\",\n",
    "}\n",
    "\n",
    "def _find_exchange_by_name(mdl, kw: str) -> str | None:\n",
    "    kw_l = kw.lower()\n",
    "    for r in mdl.reactions:\n",
    "        nm = (r.name or \"\").lower()\n",
    "        if kw_l in nm and \"exchange\" in nm:\n",
    "            return r.id\n",
    "    return None\n",
    "\n",
    "found_precursors = {k: rid for k, kw in _AA_KEYWORDS.items()\n",
    "                    if (rid := _find_exchange_by_name(model, kw)) is not None}\n",
    "found_aromas    = {k: rid for k, kw in _AROMA_KEYWORDS.items()\n",
    "                    if (rid := _find_exchange_by_name(model, kw)) is not None}\n",
    "\n",
    "AA_MW = {\"phe\":0.16519, \"leu\":0.13117, \"val\":0.11715, \"met\":0.14921, \"tyr\":0.18119}\n",
    "AROMA_MW = {\n",
    "    \"pea\":0.12217, \"isoamyl\":0.08815, \"isobutanol\":0.07412,\n",
    "    \"methionol\":0.10619, \"tyrosol\":0.13816, \"ethyl_acetate\":0.08811,\n",
    "}\n",
    "\n",
    "print(f\"\\nPrecursores AA detectados: {found_precursors}\")\n",
    "print(f\"Aromas detectados        : {found_aromas}\")\n",
    "\n",
    "# Mapas de N por fuente (1 átomo N salvo Arg/Gln)\n",
    "N_atoms_map = {rid: 1.0 for rid in KINETIC_N_SOURCE_IDS}\n",
    "N_atoms_map[RXN_IDS[\"ARG\"]] = 4.0\n",
    "N_atoms_map[RXN_IDS[\"GLN\"]] = 2.0\n",
    "N_atoms_map[RXN_IDS[\"TRP\"]] = 2.0\n",
    "\n",
    "N_profile_map = {\n",
    "    RXN_IDS[\"NH4\"]: 0.50,\n",
    "    RXN_IDS[\"ARG\"]: 0.10,\n",
    "    RXN_IDS[\"GLN\"]: 0.08,\n",
    "    RXN_IDS[\"GLU_AA\"]: 0.07,\n",
    "    RXN_IDS[\"SER\"]: 0.05,\n",
    "    RXN_IDS[\"THR\"]: 0.05,\n",
    "    RXN_IDS[\"ALA\"]: 0.05,\n",
    "    RXN_IDS[\"TRP\"]: 0.05,\n",
    "    RXN_IDS[\"LEU\"]: 0.05,\n",
    "}\n",
    "_p_sum = sum(N_profile_map.values())\n",
    "N_profile_map = {k: v/_p_sum for k, v in N_profile_map.items()}"
   ]
  },
