    "## 5. Diagnósticos FBA / FVA (read-only)\n",
    "\n",
    "Snapshot del estado del modelo recién aplicado el medio. Usa `with model as m:` para no contaminar `model`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def fba_diagnostics(mdl: cobra.Model, fva_rxns: list[str] | None = None,\n",
    "                     fva_frac: float = 0.95) -> dict:\n",
    "    \"\"\"Resuelve FBA y, opcionalmente, FVA sobre un subconjunto de reacciones.\n",
    "\n",
    "    Notes\n",
    "    -----\n",
    "    Operaciones read-only — usa context manager si quieres aislamiento total.\n",
    "    \"\"\"\n",
    "    out = {}\n",
    "    sol = mdl.optimize()\n",
    "    out[\"status\"]   = sol.status\n",
    "    out[\"obj_val\"]  = float(sol.objective_value) if sol.status == \"optimal\" else float(\"nan\")\n",
    "\n",
    "    if sol.status == \"optimal\":\n",
    "        rep_ids = [RXN_IDS[\"OBJ\"], RXN_IDS[\"GLU\"], RXN_IDS[\"FRU\"],\n",
    "                    RXN_IDS[\"ETH\"], RXN_IDS[\"ATPM\"], RXN_IDS[\"PROT\"]]\n",
    "        out[\"key_fluxes\"] = {rid: float(sol.fluxes.get(rid, float(\"nan\"))) for rid in rep_ids}\n",
    "\n",
    "    if fva_rxns:\n",
    "        try:\n",
    "            fva = cobra.flux_analysis.flux_variability_analysis(\n",
    "                mdl, reaction_list=fva_rxns, fraction_of_optimum=fva_frac)\n",
    "            out[\"fva\"] = fva\n",
    "        except Exception as exc:\n",
    "            out[\"fva_error\"] = str(exc)\n",
    "    return out\n",
    "\n",
    "\n",
    "with model as _msnap:\n",
    "    diag = fba_diagnostics(_msnap, fva_rxns=[\n",
    "        RXN_IDS[\"OBJ\"], RXN_IDS[\"ETH\"], RXN_IDS[\"GLU\"], RXN_IDS[\"FRU\"]])\n",
    "\n",
    "print(f\"FBA status : {diag['status']}\")\n",
    "print(f\"obj_value  : {diag['obj_val']:.6f}\")\n",
    "if \"key_fluxes\" in diag:\n",
    "    for rid, v in diag[\"key_fluxes\"].items():\n",
    "        print(f\"  {rid}: {v:+.4f}\")\n",
    "if \"fva\" in diag:\n",
    "    print(\"\\nFVA (fracción 0.95):\")\n",
    "    print(diag[\"fva\"])"
   ]
  },
  {
