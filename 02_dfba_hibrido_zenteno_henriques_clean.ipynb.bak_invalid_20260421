    "\n",
    "def _arrhenius_factor(T_K: float, Ea_R: float = 8000.0) -> float:\n",
    "    \"\"\"Factor Arrhenius simplificado relativo a `PARAMS['T_BASE']`.\"\"\"\n",
    "    T0 = PARAMS[\"T_BASE\"]\n",
    "    return float(np.exp(Ea_R * (1.0/T0 - 1.0/T_K)))\n",
