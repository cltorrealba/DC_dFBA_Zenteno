    "                          v_obj, v_prot, total_aa_uptake_mmol,\n",
    "                          turnover_active: bool, recycling_active: bool):\n",
    "    \"\"\"Calcula dProt/dt, dCarb/dt y dNrec/dt según Henriques eq. 7–10.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    turnover_active   : True en stationary/decay (activa λ).\n",
    "    recycling_active  : True si N_rec alimenta los uptakes (stationary/decay).\n",
    "    total_aa_uptake_mmol : suma de |v_AA| de todos los precursores [mmol/gDW/h].\n",
    "    \"\"\"\n",
    "    Xa  = PARAMS[\"XA_FRACTION\"] * cX\n",
    "    lam = PARAMS[\"TURNOVER_LAMBDA\"] if turnover_active else 0.0\n",
    "\n",
    "    dProt = (max(0.0, v_obj) * cX * PARAMS[\"PROT_CONTENT_0\"]\n",
    "             - cProt * PARAMS[\"K_DEATH\"]\n",
    "             + Xa * max(0.0, v_prot)\n",
    "             - lam * cProt)\n",
