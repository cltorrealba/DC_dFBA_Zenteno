    "    V_flux  = [[None]*ncp for _ in range(nfe)]\n",
    "    V_mode  = [[\"\"]  *ncp for _ in range(nfe)]\n",
    "    V_phase = [[\"\"]  *ncp for _ in range(nfe)]\n",
    "\n",
    "    c_prev = (initial_state(o2_init_g_l=o2_init_g_l) if y0 is None else y0).copy()\n",
    "    C_endpoints = np.zeros((nfe + 1, nc))\n",
    "    C_endpoints[0] = c_prev\n",
    "\n",
    "    for i in range(nfe):\n",
    "        for j in range(ncp): C[:, i, j] = np.maximum(c_prev, 0.0)\n",
    "        for _ in range(n_iter):\n",
    "            for j in range(ncp):\n",
    "                t_cp = float(t_loc[i, j])\n",
    "                f, m, p = fba_at_state(C[:, i, j], aerobic=aerobic, t_h=t_cp)\n",
    "                if f is None:\n",
    "                    f = V_flux[i][j] or {k: 0.0 for k in (\n",
    "                        [\"v_obj\",\"v_glu\",\"v_fru\",\"v_eth\",\"v_o2\",\"v_atpm\",\"v_prot\",\"vn_eff\",\"full_gam\"]\n",
    "                        + [f\"v_aa_{ak}\" for ak in aa_keys]\n",
    "                        + [f\"v_aroma_{ak}\" for ak in aroma_keys])}\n",
    "                V_flux[i][j], V_mode[i][j], V_phase[i][j] = f, m, p\n",
    "                CDOT[:, i, j] = compute_rhs(C[:, i, j], f, m, p)\n",
    "            C[:, i, :] = np.maximum(c_prev[:, None] + h * (CDOT[:, i, :] @ COLMAT_RADAU.T), 0.0)\n",
    "        c_prev = C[:, i, ncp-1].copy()\n",
    "        C_endpoints[i + 1] = c_prev\n",
    "\n",
    "    # ODE gap (debe ser 0 por construcción)\n",
    "    max_gap = 0.0\n",
    "    for i in range(nfe):\n",
