    "        cX=cX, cProt=cProt, cCarb=cCarb, cNrec=cNrec,\n",
    "        v_obj=fluxes[\"v_obj\"], v_prot=fluxes[\"v_prot\"],\n",
    "        total_aa_uptake_mmol=total_aa,\n",
    "        turnover_active=turnover_active,\n",
    "        recycling_active=recycling_active,\n",
    "    )\n",
    "    rhs[STATE_IDX[\"PROT\"]] = dProt\n",
    "    rhs[STATE_IDX[\"CARB\"]] = dCarb\n",
