    "            max_gap = max(max_gap, float(np.max(np.abs(cdot_chk - CDOT[srow, i, :]))))\n",
    "\n",
    "    # Empaquetar resultados\n",
    "    t_all = np.concatenate([[0.0], t_loc.ravel()])\n",
    "    Y_all = np.zeros((1 + nfe*ncp, nc))\n",
    "    Y_all[0] = C_endpoints[0]\n",
    "    for i in range(nfe):\n",
    "        for j in range(ncp): Y_all[1 + i*ncp + j] = C[:, i, j]\n",
    "    t_colloc = t_loc.ravel()\n",
    "\n",
    "    def _series(key: str) -> np.ndarray:\n",
    "        out = np.zeros(nfe * ncp)\n",
    "        for i in range(nfe):\n",
