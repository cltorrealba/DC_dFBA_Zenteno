    "\n",
    "def run_dfba_colloc(*, aerobic: bool = False, o2_init_g_l: float = 0.0,\n",
    "                     nfe: int | None = None, ncp: int = 3,\n",
    "                     t_end: float | None = None, n_iter: int | None = None,\n",
