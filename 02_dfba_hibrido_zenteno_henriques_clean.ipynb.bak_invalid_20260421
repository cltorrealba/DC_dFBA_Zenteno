    "    Kf  = PARAMS[\"Kf0\"]  / max(f, EPS)\n",
    "    Kig = PARAMS[\"Kig0\"]\n",
    "    Kie = PARAMS[\"Kie0\"]\n",
    "    Kn  = PARAMS[\"Kn0\"]  / max(f, EPS)\n",
