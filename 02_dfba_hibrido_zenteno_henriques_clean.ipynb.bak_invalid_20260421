    "                f = V_flux[i][j]\n",
    "                out[i*ncp + j] = (f.get(key, 0.0) if f else 0.0)\n",
    "        return out\n",
    "\n",
    "    states_df = pd.DataFrame({\n",
    "        \"t_h\"        : t_all,\n",
    "        \"X_gDW_L\"    : Y_all[:, STATE_IDX[\"X\"]],\n",
    "        \"N_free_gN_L\": Y_all[:, STATE_IDX[\"NFREE\"]],\n",
