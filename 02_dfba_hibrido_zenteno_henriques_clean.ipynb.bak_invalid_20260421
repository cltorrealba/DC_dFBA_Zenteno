    "    [0.37640306270047,  0.51248582618842,  0.11111111111111],\n",
    "])\n",
    "COLMAT_RADAU_INV = np.linalg.inv(COLMAT_RADAU)\n",
    "RADAU_ROOTS = np.array([0.15505102572168, 0.64494897427832, 1.0])\n",
    "\n",
    "\n",
    "def compute_rhs(yk: np.ndarray, fluxes: dict, mode: str, phase: str) -> np.ndarray:\n",
    "    \"\"\"Lado derecho del sistema ODE en unidades físicas.\"\"\"\n",
    "    s = _state_unpack(yk)\n",
    "    cX = max(0.0, s[\"cX\"]); cProt = max(0.0, s[\"cProt\"])\n",
    "    cCarb = max(0.0, s[\"cCarb\"]); cNrec = max(0.0, s[\"cNrec\"])\n",
    "    is_growth = mode in (\"BIOMASS\", \"BIOMASS_NLIM\")\n",
    "    turnover_active  = phase in (\"stationary\", \"decay\")\n",
    "    recycling_active = mode in (\"TURNOVER_ATPM\", \"DECAY\")\n",
    "\n",
    "    rhs = np.zeros(n_state)\n",
    "    rhs[STATE_IDX[\"X\"]]    = max(0.0, fluxes[\"v_obj\"]) * cX if is_growth else 0.0\n",
    "    rhs[STATE_IDX[\"NFREE\"]] = -fluxes[\"vn_eff\"] * cX if is_growth else 0.0\n",
    "    rhs[STATE_IDX[\"G\"]]    = -PARAMS[\"MW_GLU\"] * max(0.0, -fluxes[\"v_glu\"]) * cX\n",
    "    rhs[STATE_IDX[\"F\"]]    = -PARAMS[\"MW_FRU\"] * max(0.0, -fluxes[\"v_fru\"]) * cX\n",
    "    rhs[STATE_IDX[\"E\"]]    =  PARAMS[\"MW_ETH\"] * max(0.0,  fluxes[\"v_eth\"]) * cX\n",
    "    rhs[STATE_IDX[\"O2\"]]   = -PARAMS[\"MW_O2\"]  * max(0.0, -fluxes[\"v_o2\"])  * cX\n",
    "\n",
    "    total_aa = sum(max(0.0, -fluxes.get(f\"v_aa_{ak}\", 0.0)) for ak in aa_keys)\n",
