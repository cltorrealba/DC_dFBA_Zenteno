    "    t_end  = t_end  if t_end  is not None else PARAMS[\"T_END_DEFAULT\"]\n",
    "    n_iter = n_iter if n_iter is not None else PARAMS[\"N_ITER_COLLOC\"]\n",
    "    assert ncp == 3, \"Sólo soportado ncp=3 (Radau IIA 3 etapas)\"\n",
    "\n",
    "    h  = t_end / nfe\n",
    "    nc = n_state\n",
    "    t_fe_start = np.concatenate([[0.0], np.full(nfe-1, h).cumsum()])\n",
    "    t_loc = np.array([[t_fe_start[i] + RADAU_ROOTS[j]*h for j in range(ncp)] for i in range(nfe)])\n",
    "\n",
